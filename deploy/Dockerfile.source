# syntax=docker/dockerfile:1
# 构建 agent（内置 clash-meta-nw）以及 xray、sing-box 两个外部核心，并放入 Loyalsoldier 的 geoip.dat / geosite.dat。
# 手工只 COPY 已有二进制时，用同目录的 Dockerfile.image。

ARG VERSION=0.0.0
ARG XRAY_TAG=v2.2.1
ARG MIHOMO_TAG=v2.2.1
ARG SINGBOX_TAG=v2.2.1
ARG GEO_TAG=202610052207

FROM golang:1.26-alpine AS agent
RUN apk add --no-cache git
WORKDIR /src
ARG MIHOMO_TAG=v2.2.1
COPY go.mod go.sum ./
COPY third_party/clash-meta-nw third_party/clash-meta-nw
RUN GOWORK=off go mod download
COPY . .
ARG VERSION
RUN CGO_ENABLED=0 GOWORK=off go build -trimpath \
    -ldflags "-X nowhere.local/agent/internal/agent.Version=${VERSION} -X github.com/metacubex/mihomo/constant.Version=${MIHOMO_TAG}" \
    -o /out/agent ./cmd/agent

# Xray 的 go.mod 要求 Go 1.27，不能跟 agent 一样用 1.26。
FROM golang:1.27-alpine AS xray
RUN apk add --no-cache git
ARG XRAY_TAG=v2.2.1
WORKDIR /src
RUN git clone --depth 1 --branch "${XRAY_TAG}" https://github.com/ohmycggk/Xray-core.git .
ENV GOWORK=off
RUN CGO_ENABLED=0 go build -trimpath -o /out/xray ./main

FROM golang:1.25.12-alpine AS singbox
RUN apk add --no-cache git
ARG SINGBOX_TAG=v2.2.1
WORKDIR /src
RUN git clone --depth 1 --branch "${SINGBOX_TAG}" https://github.com/ohmycggk/sing-box.git .
ENV GOWORK=off
# Go 1.25 拒绝 badlinkname。流量统计仍要 with_v2ray_api，缺它会在 run 期回滚。
RUN tags="$(tr ',' '\n' < release/DEFAULT_BUILD_TAGS_OTHERS | grep -v -x -E 'badlinkname|tfogo_checklinkname0' | tr '\n' ',' | sed 's/,$//'),with_v2ray_api" \
    && CGO_ENABLED=0 go build -trimpath \
    -tags "${tags}" \
    -o /out/sing-box ./cmd/sing-box

FROM debian:bookworm-slim AS geo
ARG GEO_TAG=202610052207
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /out
RUN curl -fsSL -o geoip.dat "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/${GEO_TAG}/geoip.dat" \
    && curl -fsSL -o geoip.dat.sha256sum "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/${GEO_TAG}/geoip.dat.sha256sum" \
    && curl -fsSL -o geosite.dat "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/${GEO_TAG}/geosite.dat" \
    && curl -fsSL -o geosite.dat.sha256sum "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/${GEO_TAG}/geosite.dat.sha256sum" \
    && sha256sum -c geoip.dat.sha256sum \
    && sha256sum -c geosite.dat.sha256sum

FROM debian:bookworm-slim
ARG VERSION=0.0.0
ARG XRAY_TAG=v2.2.1
ARG MIHOMO_TAG=v2.2.1
ARG SINGBOX_TAG=v2.2.1
ARG GEO_TAG=202610052207
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /usr/share/nowhere /opt/nwd-agent/data
COPY --from=agent /out/agent /usr/local/bin/agent
COPY --from=xray /out/xray /usr/local/bin/xray
COPY --from=singbox /out/sing-box /usr/local/bin/sing-box
COPY --from=geo /out/geoip.dat /out/geosite.dat /usr/share/nowhere/
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh \
    && printf 'xray=%s\nmihomo=%s\nsing-box=%s\ngeo=%s\nagent=%s\n' \
        "${XRAY_TAG}" "${MIHOMO_TAG}" "${SINGBOX_TAG}" "${GEO_TAG}" "${VERSION}" \
        > /usr/share/nowhere/cores.txt
LABEL org.opencontainers.image.source="https://github.com/NWDock/nwdock-agent" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision.xray="${XRAY_TAG}" \
      org.opencontainers.image.revision.mihomo="${MIHOMO_TAG}" \
      org.opencontainers.image.revision.sing-box="${SINGBOX_TAG}" \
      org.opencontainers.image.revision.geo="${GEO_TAG}"
ENV AGENT_RUNTIME=docker \
    AGENT_DATA_DIR=/opt/nwd-agent/data \
    XRAY_BIN=/usr/local/bin/xray \
    XRAY_API_ADDR=127.0.0.1:10085 \
    SINGBOX_BIN=/usr/local/bin/sing-box
VOLUME ["/opt/nwd-agent/data"]
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
