# syntax=docker/dockerfile:1
# 三个 target。mihomo 只含 agent，核心在进程内；xray / singbox 仍带对应二进制，也能切到内置核心。
# docker build --target xray|mihomo|singbox

FROM debian:bookworm-slim AS base
ARG VERSION=0.0.0
ARG XRAY_TAG=
ARG MIHOMO_TAG=
ARG SINGBOX_TAG=
ARG GEO_TAG=
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /usr/share/nowhere /var/lib/nowhere-agent
COPY agent /usr/local/bin/agent
COPY geoip.dat geosite.dat /usr/share/nowhere/
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh /usr/local/bin/agent \
    && printf 'xray=%s\nmihomo=%s\nsing-box=%s\ngeo=%s\nagent=%s\n' \
        "${XRAY_TAG}" "${MIHOMO_TAG}" "${SINGBOX_TAG}" "${GEO_TAG}" "${VERSION}" \
        > /usr/share/nowhere/cores.txt
ENV AGENT_RUNTIME=docker \
    AGENT_DATA_DIR=/var/lib/nowhere-agent \
    XRAY_BIN=/usr/local/bin/xray \
    XRAY_API_ADDR=127.0.0.1:10085 \
    SINGBOX_BIN=/usr/local/bin/sing-box
VOLUME ["/var/lib/nowhere-agent"]
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM base AS xray
ARG VERSION=0.0.0
ARG XRAY_TAG=
ARG GEO_TAG=
COPY xray /usr/local/bin/xray
RUN chmod 755 /usr/local/bin/xray
LABEL org.opencontainers.image.source="https://github.com/NWDock/nwdock-agent" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="nwdock-agent-xray" \
      org.opencontainers.image.revision.xray="${XRAY_TAG}" \
      org.opencontainers.image.revision.geo="${GEO_TAG}"

FROM base AS mihomo
ARG VERSION=0.0.0
ARG MIHOMO_TAG=
ARG GEO_TAG=
LABEL org.opencontainers.image.source="https://github.com/NWDock/nwdock-agent" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="nwdock-agent" \
      org.opencontainers.image.revision.mihomo="${MIHOMO_TAG}" \
      org.opencontainers.image.revision.geo="${GEO_TAG}"

FROM base AS singbox
ARG VERSION=0.0.0
ARG SINGBOX_TAG=
ARG GEO_TAG=
COPY sing-box /usr/local/bin/sing-box
RUN chmod 755 /usr/local/bin/sing-box
LABEL org.opencontainers.image.source="https://github.com/NWDock/nwdock-agent" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="nwdock-agent-singbox" \
      org.opencontainers.image.revision.sing-box="${SINGBOX_TAG}" \
      org.opencontainers.image.revision.geo="${GEO_TAG}"
