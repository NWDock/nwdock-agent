# 节点进程读取 .env.agent。已有环境变量优先。不提交这个文件。
# 复制：cp .env.agent.example .env.agent
AGENT_RUNTIME=service
AGENT_DATA_DIR=./data
AGENT_PANEL_ENDPOINTS=https://panel.example:8089
AGENT_PANEL_SPKI_PIN=change-me
# 只在第一次登记时需要，换到证书后删掉。
# AGENT_ENROLL_TOKEN=change-me
# AGENT_IMAGE_TAG=
AGENT_XRAY_BIN=/usr/local/bin/xray
AGENT_XRAY_API_ADDR=127.0.0.1:10085
AGENT_MIHOMO_BIN=/usr/local/bin/mihomo
AGENT_SINGBOX_BIN=/usr/local/bin/sing-box
