# 节点进程读取 .env.agent。已有环境变量优先。不提交这个文件。
# 复制：cp .env.agent.example .env.agent
AGENT_RUNTIME=service
AGENT_DATA_DIR=./data
AGENT_PANEL_ENDPOINTS=https://panel.example
AGENT_PANEL_KEYPIN=change-me
# 只在节点指纹未绑定时才需要，重连一次自动完成登记，之后删掉。
# AGENT_ENROLL_TOKEN=change-me
# AGENT_IMAGE_TAG=
# 软内存上限。缺省 768MiB；off 关闭。只约束本进程，不含 xray / sing-box。
# AGENT_MEMORY_LIMIT=768MiB
# Nowhere 3.4 QUIC 窗口档位：memory / balanced / throughput。留空按 AGENT_MEMORY_LIMIT 自动选（768MiB→balanced 16MiB，高 BDP 可显式设 throughput）。
# NOW_TRANSPORT_MEMORY_PROFILE=balanced
AGENT_XRAY_BIN=/usr/local/bin/xray
AGENT_XRAY_API_ADDR=127.0.0.1:10085
AGENT_SINGBOX_BIN=/usr/local/bin/sing-box
